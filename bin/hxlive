#!/usr/bin/env bash
# hxlive – Helix in the terminal, live preview in a browser window beside it.
#
#   hxlive [files…]     Server + preview + Helix in the current directory.
#                       :q in Helix cleans everything up again.
#   hxlive init         create index.html and style.css (if missing)
#   hxlive serve        run only the live-reload server
#   hxlive preview      (re)open the preview window
#   hxlive close        close all open hxlive preview windows
#   hxlive check        validate HTML with superhtml
#
# Works on macOS and Linux (Hyprland/Omarchy or any other desktop).
# Deliberately bash-3.2 compatible so macOS's stock /bin/bash is enough.

set -euo pipefail

VERSION=0.1.0

PORT=${HXLIVE_PORT:-3000}
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/hxlive"
OS=$(uname -s)

die() { printf 'hxlive: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

usage() {
  sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
  cat <<EOF

Options:
  -p, --port N   port (default: $PORT; if taken, the next free one is used)
  -h, --help     show this help
  -v, --version  show version

Environment:
  HXLIVE_PORT      starting port
  HXLIVE_EDITOR    editor to use instead of Helix (e.g. nvim)
  HXLIVE_BROWSER   path to a Chromium-based browser
EOF
}

# --- Locating tools ---------------------------------------------------------

# Arch names the binary "helix", almost everyone else (Homebrew, Nix, …) "hx".
# "helix" comes first because "hx" is a hex editor on some Linux systems.
find_editor() {
  if [ -n "${HXLIVE_EDITOR:-}" ]; then echo "$HXLIVE_EDITOR"; return; fi
  if have helix; then echo helix; return; fi
  if have hx; then echo hx; return; fi
  die "Helix not found (macOS: brew install helix, Arch: pacman -S helix)"
}

# The server is browser-sync. If it is installed globally (e.g. via
# `mise use -g npm:browser-sync`) it starts instantly, otherwise via npx.
server_cmd() {
  if have browser-sync; then
    SERVER=(browser-sync)
  elif have npx; then
    SERVER=(npx --yes browser-sync)
  else
    die "browser-sync or Node.js missing (mise use -g npm:browser-sync)"
  fi
  SERVER+=(start --server --watch --port "$PORT"
           --no-open --no-notify --no-ui --no-online)
}

# We need a Chromium derivative: only those support --app windows without
# tabs or address bar, and a separate profile keeps the window isolated.
find_browser() {
  if [ -n "${HXLIVE_BROWSER:-}" ]; then echo "$HXLIVE_BROWSER"; return; fi
  local c
  if [ "$OS" = Darwin ]; then
    for c in "Google Chrome" Chromium "Brave Browser" "Microsoft Edge" Helium; do
      for root in /Applications "$HOME/Applications"; do
        if [ -x "$root/$c.app/Contents/MacOS/$c" ]; then
          echo "$root/$c.app/Contents/MacOS/$c"; return
        fi
      done
    done
  else
    for c in chromium chromium-browser google-chrome-stable google-chrome \
             brave brave-browser microsoft-edge-stable helium-browser; do
      if have "$c"; then command -v "$c"; return; fi
    done
  fi
  die "No Chromium-based browser found (Chrome, Chromium, Brave, Edge). Set HXLIVE_BROWSER."
}

port_busy() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }

pick_port() {
  local start=$PORT
  while port_busy "$PORT"; do
    PORT=$((PORT + 1))
    [ "$PORT" -lt $((start + 50)) ] || die "No free port found from $start"
  done
  [ "$PORT" = "$start" ] || echo "hxlive: port $start is taken, using $PORT" >&2
}

# --- Preview window ---------------------------------------------------------

profile_dir() { echo "$CACHE/browser-$PORT"; }

# Right half of the screen on macOS, as "x,y,w,h". NSScreen via JXA needs
# no accessibility permission.
mac_right_half() {
  osascript -l JavaScript -e '
    ObjC.import("AppKit");
    var s = $.NSScreen.mainScreen, f = s.frame, v = s.visibleFrame;
    var top = f.size.height - (v.origin.y + v.size.height);
    var w = Math.floor(v.size.width / 2);
    [v.origin.x + w, top, w, v.size.height].map(Math.round).join(",")
  ' 2>/dev/null
}

open_preview() {
  local url="http://localhost:$PORT" browser profile
  browser=$(find_browser)
  profile=$(profile_dir)
  mkdir -p "$profile"
  local args=(--app="$url" --user-data-dir="$profile" --no-first-run
              --no-default-browser-check)

  if [ "$OS" = Darwin ]; then
    # Chrome grabs focus. Remember which app was in front (the terminal)
    # and hand focus back afterwards.
    local front geo
    front=$(lsappinfo info -only bundleid "$(lsappinfo front)" 2>/dev/null \
            | sed -n 's/.*="\(.*\)"/\1/p')
    if geo=$(mac_right_half) && [ -n "$geo" ]; then
      IFS=, read -r x y w h <<<"$geo"
      args+=(--window-position="$x,$y" --window-size="$w,$h")
    fi
    nohup "$browser" "${args[@]}" >/dev/null 2>&1 &
    if [ -n "$front" ]; then sleep 0.8; open -b "$front"; fi

  elif [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && have hyprctl; then
    # Hyprland tiles the window next to the terminal;
    # no_initial_focus keeps focus on Helix.
    # Wrap each argument in '…' so spaces in paths survive the shell
    # Hyprland runs the command in.
    local cmd="" a out
    for a in "$browser" "${args[@]}"; do cmd+="'${a//\'/\'\\\'\'}' "; done
    # Try the new Lua config syntax (0.55+) first, then classic dispatch.
    out=$(hyprctl dispatch "hl.dsp.exec_cmd(\"${cmd//\"/\\\"}\", { no_initial_focus = true })" 2>&1 || true)
    if [ "$out" != ok ]; then
      hyprctl dispatch exec "[no_initial_focus] $cmd" >/dev/null
    fi

  else
    nohup "$browser" "${args[@]}" >/dev/null 2>&1 &
  fi
}

# Only matches browser processes using our profile, never your normal browser.
close_preview() {
  pkill -f -- "--user-data-dir=$(profile_dir)( |\$)" 2>/dev/null || true
}

close_all() {
  pkill -f -- "--user-data-dir=$CACHE/browser-" 2>/dev/null || true
}

# --- Commands ---------------------------------------------------------------

cmd_dev() {
  local editor
  editor=$(find_editor)
  pick_port
  server_cmd
  mkdir -p "$CACHE"
  local log="$CACHE/server-$PORT.log"

  "${SERVER[@]}" >"$log" 2>&1 &
  local server=$!
  # npx runs node as a child process, so kill the children too.
  trap 'pkill -P '"$server"' 2>/dev/null || true; kill '"$server"' 2>/dev/null || true; close_preview' EXIT
  trap 'exit 130' INT TERM

  # npx downloads on first run, so wait generously.
  local i
  for i in $(seq 1 300); do
    port_busy "$PORT" && break
    kill -0 "$server" 2>/dev/null || break
    sleep 0.1
  done
  if ! port_busy "$PORT"; then
    echo "hxlive: server failed to start, log ($log):" >&2
    cat "$log" >&2
    exit 1
  fi

  open_preview

  # No arguments: open the usual suspects, otherwise the directory.
  if [ $# -eq 0 ]; then
    local f
    for f in index.html style.css script.js main.js; do
      [ -e "$f" ] && set -- "$@" "$f"
    done
    [ $# -gt 0 ] || set -- .
  fi
  "$editor" "$@"
}

cmd_init() {
  if [ -e index.html ]; then
    echo "index.html already exists, leaving it alone."
  else
    cat >index.html <<'EOF'
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Playground</title>
  <link rel="stylesheet" href="style.css">
</head>

<body>
  <main>
    <h1>Hello!</h1>
    <p>Change something, save with <kbd>:w</kbd> and watch the preview.</p>
  </main>
</body>

</html>
EOF
    echo "Created index.html."
  fi
  if [ -e style.css ]; then
    echo "style.css already exists, leaving it alone."
  else
    cat >style.css <<'EOF'
:root {
  --accent: #e8590c;
  --bg: #fdfcfb;
  --text: #1f1d1b;
  color-scheme: light dark;
}

@media (prefers-color-scheme: dark) {
  :root {
    --bg: #171514;
    --text: #f1ece7;
  }
}

body {
  margin: 0;
  font-family: system-ui, sans-serif;
  line-height: 1.6;
  color: var(--text);
  background: var(--bg);
}

main {
  max-width: 40rem;
  margin: 0 auto;
  padding: 3rem 1rem;
}

h1 {
  color: var(--accent);
}
EOF
    echo "Created style.css."
  fi
}

cmd_check() {
  have superhtml || die "superhtml missing (mise use -g superhtml)"
  superhtml check "${1:-.}"
}

# --- Arguments --------------------------------------------------------------

ARGS=()
CMD=dev
while [ $# -gt 0 ]; do
  case $1 in
    -p|--port) [ $# -ge 2 ] || die "--port needs a number"; PORT=$2; shift 2 ;;
    --port=*)  PORT=${1#*=}; shift ;;
    -h|--help) usage; exit 0 ;;
    -v|--version) echo "hxlive $VERSION"; exit 0 ;;
    --) shift; ARGS+=("$@"); break ;;
    *) ARGS+=("$1"); shift ;;
  esac
done

if [ ${#ARGS[@]} -gt 0 ]; then
  case ${ARGS[0]} in
    init|serve|close|check|preview) CMD=${ARGS[0]}; ARGS=("${ARGS[@]:1}") ;;
  esac
fi

case $CMD in
  dev)     cmd_dev ${ARGS[@]+"${ARGS[@]}"} ;;
  init)    cmd_init ;;
  serve)   pick_port; server_cmd; exec "${SERVER[@]}" ;;
  preview) open_preview ;;
  close)   close_all ;;
  check)   cmd_check ${ARGS[@]+"${ARGS[@]}"} ;;
esac
