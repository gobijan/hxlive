#!/usr/bin/env bash
# hxlive – Helix im Terminal, Live-Preview im Browserfenster daneben.
#
#   hxlive [dateien…]   Server + Vorschau + Helix im aktuellen Ordner.
#                       :q in Helix räumt alles wieder ab.
#   hxlive init         index.html und style.css anlegen (falls nicht da)
#   hxlive serve        nur den Live-Reload-Server starten
#   hxlive close        alle offenen hxlive-Vorschaufenster schließen
#   hxlive check        HTML mit superhtml prüfen
#
# Läuft auf macOS und Linux (Hyprland/Omarchy oder beliebiger Desktop).
# Absichtlich bash-3.2-kompatibel, damit das macOS-eigene /bin/bash reicht.

set -euo pipefail

VERSION=0.1.0

PORT=${HXLIVE_PORT:-3000}
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/hxlive"
OS=$(uname -s)

die() { printf 'hxlive: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

usage() {
  sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
  cat <<EOF

Optionen:
  -p, --port N   Port (Standard: $PORT, belegt → nächster freier)
  -h, --help     diese Hilfe
  -v, --version  Version

Umgebungsvariablen:
  HXLIVE_PORT      Startport
  HXLIVE_EDITOR    Editor statt Helix (z. B. nvim)
  HXLIVE_BROWSER   Pfad zu einem Chromium-artigen Browser
EOF
}

# --- Werkzeuge finden -------------------------------------------------------

# Arch nennt das Binary "helix", fast alle anderen (Homebrew, Nix, …) "hx".
# "helix" zuerst, weil "hx" auf manchen Linux-Systemen ein Hex-Editor ist.
find_editor() {
  if [ -n "${HXLIVE_EDITOR:-}" ]; then echo "$HXLIVE_EDITOR"; return; fi
  if have helix; then echo helix; return; fi
  if have hx; then echo hx; return; fi
  die "Helix nicht gefunden (macOS: brew install helix, Arch: pacman -S helix)"
}

# Der Server läuft über browser-sync. Global installiert (z. B. per
# `mise use -g npm:browser-sync`) startet er sofort, sonst einmalig via npx.
server_cmd() {
  if have browser-sync; then
    SERVER=(browser-sync)
  elif have npx; then
    SERVER=(npx --yes browser-sync)
  else
    die "browser-sync oder Node.js fehlt (mise use -g npm:browser-sync)"
  fi
  SERVER+=(start --server --watch --port "$PORT"
           --no-open --no-notify --no-ui --no-online)
}

# Gesucht wird ein Chromium-Abkömmling, weil nur der --app-Fenster ohne
# Tabs und Adressleiste kann und ein eigenes Profil sauber abtrennbar ist.
find_browser() {
  if [ -n "${HXLIVE_BROWSER:-}" ]; then echo "$HXLIVE_BROWSER"; return; fi
  local c
  if [ "$OS" = Darwin ]; then
    for c in "Google Chrome" Chromium "Brave Browser" "Microsoft Edge" Helium; do
      for root in /Applications "$HOME/Applications"; do
        if [ -x "$root/$c.app/Contents/MacOS/$c" ]; then
          echo "$root/$c.app/Contents/MacOS/$c"; return
        fi
      done
    done
  else
    for c in chromium chromium-browser google-chrome-stable google-chrome \
             brave brave-browser microsoft-edge-stable helium-browser; do
      if have "$c"; then command -v "$c"; return; fi
    done
  fi
  die "Kein Chromium-Browser gefunden (Chrome, Chromium, Brave, Edge). HXLIVE_BROWSER setzen."
}

port_busy() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }

pick_port() {
  local start=$PORT
  while port_busy "$PORT"; do
    PORT=$((PORT + 1))
    [ "$PORT" -lt $((start + 50)) ] || die "Kein freier Port ab $start gefunden"
  done
  [ "$PORT" = "$start" ] || echo "hxlive: Port $start belegt, nehme $PORT" >&2
}

# --- Vorschaufenster --------------------------------------------------------

profile_dir() { echo "$CACHE/browser-$PORT"; }

# Rechte Bildschirmhälfte auf dem Mac, als "x,y,w,h". NSScreen über JXA
# braucht keine Bedienungshilfen-Freigabe.
mac_right_half() {
  osascript -l JavaScript -e '
    ObjC.import("AppKit");
    var s = $.NSScreen.mainScreen, f = s.frame, v = s.visibleFrame;
    var top = f.size.height - (v.origin.y + v.size.height);
    var w = Math.floor(v.size.width / 2);
    [v.origin.x + w, top, w, v.size.height].map(Math.round).join(",")
  ' 2>/dev/null
}

open_preview() {
  local url="http://localhost:$PORT" browser profile
  browser=$(find_browser)
  profile=$(profile_dir)
  mkdir -p "$profile"
  local args=(--app="$url" --user-data-dir="$profile" --no-first-run
              --no-default-browser-check)

  if [ "$OS" = Darwin ]; then
    # Chrome reißt den Fokus an sich. Vorher merken, wer vorne war
    # (das Terminal), und danach zurückgeben.
    local front geo
    front=$(lsappinfo info -only bundleid "$(lsappinfo front)" 2>/dev/null \
            | sed -n 's/.*="\(.*\)"/\1/p')
    if geo=$(mac_right_half) && [ -n "$geo" ]; then
      IFS=, read -r x y w h <<<"$geo"
      args+=(--window-position="$x,$y" --window-size="$w,$h")
    fi
    nohup "$browser" "${args[@]}" >/dev/null 2>&1 &
    if [ -n "$front" ]; then sleep 0.8; open -b "$front"; fi

  elif [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && have hyprctl; then
    # Hyprland kachelt das Fenster rechts neben das Terminal;
    # no_initial_focus lässt den Fokus bei Helix.
    # Jedes Argument in '…', damit Leerzeichen in Pfaden die Shell überleben,
    # in der Hyprland den Befehl ausführt.
    local cmd="" a out
    for a in "$browser" "${args[@]}"; do cmd+="'${a//\'/\'\\\'\'}' "; done
    # Neue Lua-Config (0.55+) zuerst, sonst die klassische Dispatch-Syntax.
    out=$(hyprctl dispatch "hl.dsp.exec_cmd(\"${cmd//\"/\\\"}\", { no_initial_focus = true })" 2>&1 || true)
    if [ "$out" != ok ]; then
      hyprctl dispatch exec "[no_initial_focus] $cmd" >/dev/null
    fi

  else
    nohup "$browser" "${args[@]}" >/dev/null 2>&1 &
  fi
}

# Trifft nur Browser-Prozesse mit unserem Profil, nie das normale Chrome.
close_preview() {
  pkill -f -- "--user-data-dir=$(profile_dir)( |\$)" 2>/dev/null || true
}

close_all() {
  pkill -f -- "--user-data-dir=$CACHE/browser-" 2>/dev/null || true
}

# --- Befehle ----------------------------------------------------------------

cmd_dev() {
  local editor
  editor=$(find_editor)
  pick_port
  server_cmd
  mkdir -p "$CACHE"
  local log="$CACHE/server-$PORT.log" url="http://localhost:$PORT"

  "${SERVER[@]}" >"$log" 2>&1 &
  local server=$!
  # npx startet node als Kindprozess, deshalb auch die Kinder beenden.
  trap 'pkill -P '"$server"' 2>/dev/null || true; kill '"$server"' 2>/dev/null || true; close_preview' EXIT
  trap 'exit 130' INT TERM

  # npx lädt beim ersten Mal erst herunter, daher großzügig warten.
  local i
  for i in $(seq 1 300); do
    port_busy "$PORT" && break
    kill -0 "$server" 2>/dev/null || break
    sleep 0.1
  done
  if ! port_busy "$PORT"; then
    echo "hxlive: Server startet nicht, Log ($log):" >&2
    cat "$log" >&2
    exit 1
  fi

  open_preview

  # Ohne Argumente: die üblichen Verdächtigen, sonst den Ordner.
  if [ $# -eq 0 ]; then
    local f
    for f in index.html style.css script.js main.js; do
      [ -e "$f" ] && set -- "$@" "$f"
    done
    [ $# -gt 0 ] || set -- .
  fi
  "$editor" "$@"
}

cmd_init() {
  if [ -e index.html ]; then
    echo "index.html gibt es schon, lasse sie in Ruhe."
  else
    cat >index.html <<'EOF'
<!DOCTYPE html>
<html lang="de">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Spielwiese</title>
  <link rel="stylesheet" href="style.css">
</head>

<body>
  <main>
    <h1>Hallo!</h1>
    <p>Ändere etwas, speichere mit <kbd>:w</kbd> und schau rechts zu.</p>
  </main>
</body>

</html>
EOF
    echo "index.html angelegt."
  fi
  if [ -e style.css ]; then
    echo "style.css gibt es schon, lasse sie in Ruhe."
  else
    cat >style.css <<'EOF'
:root {
  --accent: #e8590c;
  --bg: #fdfcfb;
  --text: #1f1d1b;
  color-scheme: light dark;
}

@media (prefers-color-scheme: dark) {
  :root {
    --bg: #171514;
    --text: #f1ece7;
  }
}

body {
  margin: 0;
  font-family: system-ui, sans-serif;
  line-height: 1.6;
  color: var(--text);
  background: var(--bg);
}

main {
  max-width: 40rem;
  margin: 0 auto;
  padding: 3rem 1rem;
}

h1 {
  color: var(--accent);
}
EOF
    echo "style.css angelegt."
  fi
}

cmd_check() {
  have superhtml || die "superhtml fehlt (mise use -g superhtml)"
  superhtml check "${1:-.}"
}

# --- Argumente --------------------------------------------------------------

ARGS=()
CMD=dev
while [ $# -gt 0 ]; do
  case $1 in
    -p|--port) [ $# -ge 2 ] || die "--port braucht eine Zahl"; PORT=$2; shift 2 ;;
    --port=*)  PORT=${1#*=}; shift ;;
    -h|--help) usage; exit 0 ;;
    -v|--version) echo "hxlive $VERSION"; exit 0 ;;
    --) shift; ARGS+=("$@"); break ;;
    *) ARGS+=("$1"); shift ;;
  esac
done

if [ ${#ARGS[@]} -gt 0 ]; then
  case ${ARGS[0]} in
    init|serve|close|check|preview) CMD=${ARGS[0]}; ARGS=("${ARGS[@]:1}") ;;
  esac
fi

case $CMD in
  dev)     cmd_dev ${ARGS[@]+"${ARGS[@]}"} ;;
  init)    cmd_init ;;
  serve)   pick_port; server_cmd; exec "${SERVER[@]}" ;;
  preview) open_preview ;;
  close)   close_all ;;
  check)   cmd_check ${ARGS[@]+"${ARGS[@]}"} ;;
esac
